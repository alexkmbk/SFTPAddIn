// Код выполняется на той стороне, где будет использоваться компонента:
// в Windows-клиенте либо на сервере 1С.
// ИмяМодуля = "SFTPAddIn"; имя класса, экспортируемого DLL, = "SFTP".
Местоположение = ПутьКПакетуИлиDLL;
Если НРег(Прав(Местоположение, 4)) = ".zip" Тогда
    Местоположение = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(Местоположение));
КонецЕсли;
Если Не ПодключитьВнешнююКомпоненту(
    Местоположение, "SFTPAddIn", ТипВнешнейКомпоненты.Native) Тогда
    ВызватьИсключение "Не удалось подключить SFTPAddIn";
КонецЕсли;

SFTP = Новый("AddIn.SFTPAddIn.SFTP");
SFTP.Timeout = 30;

// Ожидаемый отпечаток получают у администратора SFTP-сервера.
// Полная SHA-256-строка WinSCP/PuTTY: "ssh-ed25519 255 <Base64 отпечаток>".
// Пустая строка (или пропуск пятого параметра) отключает проверку ключа.
Попытка
    SFTP.Connect(АдресСервера, 22, ИмяПользователя, Пароль, ОтпечатокSHA256);
    СтрокаJSON = SFTP.ListFiles("/exchange");
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(СтрокаJSON);
    СписокФайлов = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();

    // При вызове на сервере путь относится к диску сервера.
    // Передаём полный путь, включая локальное имя. Родительские папки создаются.
    // Третий параметр Истина запрещает замену; по умолчанию она разрешена.
    ЛокальныйПуть = SFTP.GetFile("/exchange/report.csv", "D:\Import\report.csv");

    // Возвращает тип ДвоичныеДанные, без локального временного файла.
    СодержимоеФайла = SFTP.GetFileBinData("/exchange/report.csv");

    // Проверяем один конкретный путь, без перечисления каталога.
    СведенияJSON = SFTP.Stat("/archive/report.csv");

    // Второй параметр — полный конечный путь на том же SFTP-сервере.
    // По умолчанию замена запрещена; третий параметр Истина разрешает её,
    // только если сервер поддерживает posix-rename@openssh.com.
    SFTP.MoveFile("/exchange/report.csv", "/archive/report.csv");

    // Пример удаления конкретного файла (если это требуется процессом).
    // SFTP.DeleteFile("/archive/report.csv");

    // Отправка одного файла: оба пути включают имя файла.
    // NewerOnly сравнивает время изменения; пропущенный исходник не удаляется.
    // Передан = SFTP.PutFile("D:\Export\order.xml", "/inbox/order.xml", Ложь, Истина);

    // Все непосредственные файлы каталога, без подкаталогов.
    // Третий параметр Истина удаляет каждый исходник после успешной отправки.
    // РезультатJSON = SFTP.PutFiles("D:\Export", "/inbox", Истина, Истина);
    // При исключении LastErrorDetails содержит объект upload с частичным результатом.
Исключение
    ТекстОшибки = SFTP.LastError;
    ПодробностиОшибкиJSON = SFTP.LastErrorDetails;
    // Сначала копируем диагностику: Disconnect очистит её в компоненте.
    // Для ошибок вне компоненты (например, чтения JSON) используем штатный текст.
    Если ТекстОшибки = "" Тогда
        ТекстОшибки = ОписаниеОшибки();
    КонецЕсли;
    SFTP.Disconnect();
    // Явно поднимаем исключение 1С с текстом, прочитанным из компоненты.
    ВызватьИсключение ТекстОшибки;
КонецПопытки;
SFTP.Disconnect();
