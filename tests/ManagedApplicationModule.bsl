Процедура ПриНачалеРаботыСистемы()
    ПараметрыТеста = Неопределено;
    SFTP = Неопределено;
    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.ОткрытьФайл(ПараметрЗапуска);
        ПараметрыТеста = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();

        Местоположение = ПараметрыТеста.Пакет;
        Если ПараметрыТеста.Архив Тогда
            Местоположение = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(Местоположение));
        КонецЕсли;
        Если Не ПодключитьВнешнююКомпоненту(
            Местоположение, "SFTPAddIn", ТипВнешнейКомпоненты.Native) Тогда
            ВызватьИсключение "Не удалось загрузить компоненту";
        КонецЕсли;
        SFTP = Новый("AddIn.SFTPAddIn.SFTP");
        Если SFTP.Version <> "0.2.0" Тогда
            ВызватьИсключение "Неверная версия";
        КонецЕсли;
        SFTP.Timeout = 5;
        SFTP.Connect("127.0.0.1", ПараметрыТеста.Порт, "test", "test-password", ПараметрыТеста.Отпечаток);
        JSON = SFTP.ListFiles("/");
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(JSON);
        Файлы = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Если Файлы.Количество() = 0 Тогда
            ВызватьИсключение "Пустой список";
        КонецЕсли;
        Данные = SFTP.GetFileBinData("/payload.bin");
        Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Или Данные.Размер() <> 300123 Тогда
            ВызватьИсключение "Неверные двоичные данные";
        КонецЕсли;
        Данные.Записать(ПараметрыТеста.ДвоичныйФайл);
        Пустой = SFTP.GetFileBinData("/empty.bin");
        Если Пустой.Размер() <> 0 Тогда
            ВызватьИсключение "Неверный пустой файл";
        КонецЕсли;
        Путь = SFTP.GetFile("/payload.bin", ПараметрыТеста.Папка + "\renamed.bin");
        Файл = Новый Файл(Путь);
        Если Файл.Размер() <> 300123 Тогда
            ВызватьИсключение "Неверный файл на диске";
        КонецЕсли;
        Если Не SFTP.PutFile(Путь, "/uploads/client-single.bin", Ложь, Истина) Тогда
            ВызватьИсключение "PutFile не передал новый файл";
        КонецЕсли;
        Если SFTP.PutFile(Путь, "/uploads/client-single.bin", Истина, Истина) Тогда
            ВызватьИсключение "NewerOnly повторно передал неизменённый файл";
        КонецЕсли;
        Если Не Файл.Существует() Тогда
            ВызватьИсключение "NewerOnly удалил пропущенный исходник";
        КонецЕсли;
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(SFTP.PutFiles(ПараметрыТеста.ПапкаОтправки, "/uploads", Истина));
        Отправка = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Если Отправка.uploaded.Количество() <> 2 Или Отправка.pending.Количество() <> 0 Тогда
            ВызватьИсключение "Неверный результат PutFiles";
        КонецЕсли;
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(SFTP.Stat("/missing.bin"));
        Сведения = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Если Сведения.exists Тогда
            ВызватьИсключение "Stat: отсутствующий файл существует";
        КонецЕсли;
        ОтказПерезаписи = Ложь;
        Попытка
            SFTP.GetFile("/payload.bin", Путь, Истина);
        Исключение
            ТекстОшибки = SFTP.LastError;
            ПодробностиОшибки = SFTP.LastErrorDetails;
            ОтказПерезаписи = СтрНайти(ТекстОшибки, "Save local file") > 0;
        КонецПопытки;
        Если Не ОтказПерезаписи Тогда
            ВызватьИсключение "Ошибка запрета перезаписи не получена через LastError";
        КонецЕсли;
        SFTP.Disconnect();
        Если SFTP.LastError <> "" Или SFTP.LastErrorDetails <> "{}" Тогда
            ВызватьИсключение "Disconnect не очистил ошибку";
        КонецЕсли;
        Если ТекстОшибки = "" Или ПодробностиОшибки = "{}" Тогда
            ВызватьИсключение "Ошибка не сохранена до отключения";
        КонецЕсли;
        SFTP.Connect("127.0.0.1", ПараметрыТеста.Порт, "test", "test-password", ПараметрыТеста.Отпечаток);
        SFTP.MoveFile("/move.bin", "/archive/renamed.bin");
        SFTP.DeleteFile("/archive/renamed.bin");
        SFTP.Disconnect();
        Результат = "OK";
    Исключение
        Результат = ОписаниеОшибки();
        Если SFTP <> Неопределено Тогда
            Если SFTP.LastError <> "" Тогда
                Результат = Результат + Символы.ПС + SFTP.LastError;
            КонецЕсли;
        КонецЕсли;
    КонецПопытки;
    Если ПараметрыТеста <> Неопределено Тогда
        Документ = Новый ТекстовыйДокумент;
        Документ.УстановитьТекст(Результат);
        Документ.Записать(ПараметрыТеста.Результат, КодировкаТекста.UTF8);
    КонецЕсли;
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
